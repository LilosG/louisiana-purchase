---
// src/components/ui/MenuShowcase.astro
// Louisiana Purchase — Menu Item Grid, sourced from Astro content collections
// Thin transform over FourColumnGrid so menu displays inherit the same
// card styling as every other grid on the site rather than reinventing it.

import FourColumnGrid from './FourColumnGrid.astro';
import { IMAGES } from '../../assets/images';
import type { MenuData, MenuItem } from '../../types/menu';
import { getOrderedCollection, getSingleton } from '../../content/siteData';

const [cocktails, oxtailKingdom, creoleSoulBangers, gulf, fryHouse, brunch] = await Promise.all([
  getOrderedCollection('cocktailsMenu'),
  getOrderedCollection('kitchenOxtailKingdom'),
  getOrderedCollection('kitchenCreoleSoulBangers'),
  getOrderedCollection('kitchenGulf'),
  getOrderedCollection('kitchenFryHouse'),
  getOrderedCollection('brunchMenuItems'),
]);
const menuPage = await getSingleton('menuIndexPage', 'page');
const itemCollections: Record<string, MenuItem[]> = { cocktails, oxtailKingdom, creoleSoulBangers, gulf, fryHouse, brunch };
const menuSections = Array.isArray(menuPage.menuStructure?.sections) ? menuPage.menuStructure.sections : [];
const data = {
  ...(menuPage.menuStructure ?? {}),
  sections: menuSections.map((section: any) => ({
    ...section,
    categories: (Array.isArray(section.categories) ? section.categories : []).map((category: any) => ({
      ...category,
      items: itemCollections[category.collection] ?? [],
    })),
  })),
} as MenuData;

interface Props {
  section?:      string | string[];   // content section id(s), e.g. "cocktails" | "food" | "brunch"
  category?:     string;               // optional category id within the section(s)
  featuredOnly?: boolean;              // only items where featured === true
  itemIds?:      string[];             // exact item ids, in this order — for hand-curated highlight grids
  limit?:        number;               // cap the number of items rendered
  cols?:         2 | 3 | 4;
  dark?:         boolean;
  divided?:      boolean;
  showPrice?:    boolean;              // default false — price remains stored with each menu item
  headingLevel?: 2 | 3 | 4;            // heading level for item titles (passed to FourColumnGrid)
  categoryHeadingLevel?: 2 | 3;        // when set, items are grouped under their menuStructure category label as headings of this level
}

const {
  section,
  category,
  featuredOnly = false,
  itemIds,
  limit,
  cols = 4,
  dark = true,
  divided = true,
  showPrice = false,
  headingLevel = 3,
  categoryHeadingLevel,
} = Astro.props as Props;

interface ItemWithCategory {
  item:          MenuItem;
  categoryLabel: string;
}

const allWithCategory: ItemWithCategory[] = data.sections.flatMap((s) =>
  s.categories.flatMap((c) => c.items.map((item) => ({ item, categoryLabel: c.label })))
);

let entries: ItemWithCategory[];

if (itemIds) {
  entries = itemIds
    .map((id: string) => allWithCategory.find((entry) => entry.item.id === id))
    .filter((entry: ItemWithCategory | undefined): entry is ItemWithCategory => Boolean(entry));
} else {
  const sectionIds = section ? (Array.isArray(section) ? section : [section]) : undefined;
  const matchedSections = sectionIds
    ? data.sections.filter((s) => sectionIds.includes(s.id))
    : data.sections;

  entries = matchedSections.flatMap((s) =>
    s.categories
      .filter((c) => !category || c.id === category)
      .flatMap((c) => c.items.map((item) => ({ item, categoryLabel: c.label })))
  );
}

entries = entries.filter((entry) => entry.item.available);

if (featuredOnly) {
  entries = entries.filter((entry) => entry.item.featured);
}

if (limit) {
  entries = entries.slice(0, limit);
}

const toCard = ({ item, categoryLabel }: ItemWithCategory) => {
  const image = item.image ? IMAGES[item.image as keyof typeof IMAGES] : undefined;

  return {
    image,
    imageFallback: !image,
    imageAlt: item.imageAlt || item.name,
    eyebrow:  categoryLabel,
    title:    item.name,
    body:     item.description,
    meta:     showPrice ? item.priceDisplay : undefined,
  };
};
const cards = entries.map(toCard);

// Category groups keep the menuStructure order (entries are already in that order).
const groups: { label: string; cards: ReturnType<typeof toCard>[] }[] = [];
for (const entry of entries) {
  const group = groups.find((g) => g.label === entry.categoryLabel);
  if (group) group.cards.push(toCard(entry));
  else groups.push({ label: entry.categoryLabel, cards: [toCard(entry)] });
}
const CategoryHeading = `h${categoryHeadingLevel ?? 3}` as 'h2' | 'h3';
---

{categoryHeadingLevel ? (
  <div class="flex flex-col gap-12 md:gap-16">
    {groups.map((group) => (
      <div>
        <CategoryHeading class="font-sans text-[0.625rem] font-medium tracking-[0.32em] uppercase text-gold mb-5">
          {group.label}
        </CategoryHeading>
        <FourColumnGrid
          cols={cols}
          dark={dark}
          divided={divided}
          cards={group.cards}
          headingLevel={headingLevel}
        />
      </div>
    ))}
  </div>
) : (
  <FourColumnGrid
    cols={cols}
    dark={dark}
    divided={divided}
    cards={cards}
    headingLevel={headingLevel}
  />
)}
