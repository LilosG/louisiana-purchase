---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
---

<div id="lilos-consent-banner" class="lilos-consent-banner" role="region" aria-label="Privacy notice" hidden>
  <div class="lilos-consent-inner">
    <p class="lilos-consent-text">
      We use Google Analytics to measure site traffic. We do not sell or share your personal information.
      You can opt out at any time.
    </p>
    <div class="lilos-consent-actions">
      <button type="button" id="lilos-consent-optout" class="lilos-btn lilos-btn-secondary">Opt out</button>
      <a href="/privacy" class="lilos-btn lilos-btn-secondary">Privacy Policy</a>
      <button type="button" id="lilos-consent-gotit" class="lilos-btn lilos-btn-primary">Got it</button>
    </div>
  </div>
</div>

<style>
  .lilos-consent-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--consent-bg, #14161a);
    color: var(--consent-text, #f4f4f5);
    border-top: 1px solid var(--consent-border, rgba(255, 255, 255, 0.1));
    padding: 1rem 1.25rem;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.25);
    transform: translateY(0);
    transition: transform 0.25s ease-out;
  }

  .lilos-consent-banner[hidden] {
    display: none;
  }

  .lilos-consent-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lilos-consent-text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 48rem;
    color: var(--consent-text, #f4f4f5);
  }

  .lilos-consent-actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
    align-items: center;
  }

  .lilos-btn {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: opacity 0.15s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .lilos-btn:hover {
    opacity: 0.85;
  }

  .lilos-btn:focus-visible {
    outline: 2px solid var(--consent-accent, #7dd3fc);
    outline-offset: 2px;
  }

  .lilos-btn-primary {
    background: var(--consent-accent, #f4f4f5);
    color: var(--consent-bg, #14161a);
  }

  .lilos-btn-secondary {
    background: transparent;
    color: var(--consent-text, #f4f4f5);
    border-color: var(--consent-border, rgba(255, 255, 255, 0.3));
  }

  @media (max-width: 640px) {
    .lilos-consent-inner {
      flex-direction: column;
      align-items: stretch;
    }
    .lilos-consent-actions {
      justify-content: flex-end;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'lilos-privacy-v1';

    function readRecord() {
      try {
        var raw = localStorage.getItem(KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function hideBanner() {
      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = true;
    }

    function init() {
      if (navigator.globalPrivacyControl === true) return;
      if (readRecord() !== null) return;

      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = false;

      var gotit = document.getElementById('lilos-consent-gotit');
      if (gotit) {
        gotit.addEventListener('click', function () {
          try { localStorage.setItem(KEY, JSON.stringify({ optOut: false, ts: Date.now() })); } catch (e) {}
          hideBanner();
        });
      }

      var optout = document.getElementById('lilos-consent-optout');
      if (optout) {
        optout.addEventListener('click', function () {
          if (window.lilosPrivacy && typeof window.lilosPrivacy.optOut === 'function') {
            window.lilosPrivacy.optOut();
          }
          hideBanner();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
