---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{GA_ID && (
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var NEW_KEY = 'lilos-privacy-v1';
      var OLD_KEY = 'lilos-consent-v1';

      function readPrivacyRecord() {
        try {
          var raw = localStorage.getItem(NEW_KEY);
          if (!raw) return null;
          var parsed = JSON.parse(raw);
          if (!parsed || typeof parsed.ts !== 'number') return null;
          return parsed;
        } catch (e) {
          return null;
        }
      }

      function writePrivacyRecord(optOut) {
        try {
          localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: !!optOut, ts: Date.now() }));
        } catch (e) {}
      }

      function migrate() {
        if (localStorage.getItem(NEW_KEY)) return;
        try {
          var raw = localStorage.getItem(OLD_KEY);
          if (!raw) return;
          var old = JSON.parse(raw);
          if (old && old.analytics === false) {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: old.ts || Date.now() }));
          }
        } catch (e) {}
      }

      function initAnalytics() {
        if (window.__lilosGA4Loaded) return;
        window.__lilosGA4Loaded = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };

        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted'
        });

        window.gtag('js', new Date());
        window.gtag('config', GA_ID, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);

        document.addEventListener('click', function (e) {
          var link = e.target.closest('a[href*="resy.com"], a[href*="toasttab.com"], a[href*="opentable.com"], a[href*="toast.app"]');
          if (!link) return;

          var eventName = 'external_link_click';
          var reservationSystem = null;
          try {
            var href = link.href.toLowerCase();
            if (href.includes('opentable.com')) { eventName = 'reservation_click'; reservationSystem = 'opentable'; }
            else if (href.includes('toast.app')) { eventName = 'reservation_click'; reservationSystem = 'toast_legacy'; }
            else if (href.includes('resy.com')) { eventName = 'reservation_click'; reservationSystem = 'resy'; }
            else if (href.includes('giftcard')) eventName = 'gift_card_click';
            else if (href.includes('toasttab.com')) eventName = 'order_click';
            else if (href.includes('catering')) eventName = 'catering_click';
          } catch (err) {}

          if (typeof gtag === 'function') {
            gtag('event', eventName, {
              link_url: link.href,
              page_path: window.location.pathname,
              ...(reservationSystem ? { reservation_system: reservationSystem } : {}),
            });
          }
        }, { passive: true });

        document.addEventListener('click', function (e) {
          var link = e.target.closest('a[href$="#event-inquiry"]');
          if (!link) return;
          if (typeof gtag === 'function') {
            gtag('event', 'private_events_cta_click', {
              link_url: link.href,
              page_path: window.location.pathname,
            });
          }
        }, { passive: true });

        if ('IntersectionObserver' in window) {
          var forms = document.querySelectorAll('[data-toast-event-form]');
          if (forms.length) {
            var observer = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting && typeof gtag === 'function') {
                  gtag('event', 'private_events_form_viewed', {
                    page_path: window.location.pathname,
                  });
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.25 });
            forms.forEach(function (form) { observer.observe(form); });
          }
        }
      }

      window.lilosPrivacy = {
        isOptedOut: function () {
          var rec = readPrivacyRecord();
          return !!(rec && rec.optOut);
        },
        optOut: function () {
          writePrivacyRecord(true);
          window['ga-disable-' + GA_ID] = true;
        },
        optIn: function () {
          writePrivacyRecord(false);
        },
      };

      migrate();

      if (navigator.globalPrivacyControl === true) return;

      var record = readPrivacyRecord();
      if (record && record.optOut) return;

      initAnalytics();
    })();
  </script>
)}
