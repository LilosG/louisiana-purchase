---
// src/components/core/LocalSEO.astro
// Louisiana Purchase — Centralized SEO & AEO Engine
//
// Responsibilities:
//   1. Injects <meta> tags: title, description, canonical, OG, Twitter Card
//   2. Emits ONE JSON-LD <script> per page containing a single @graph:
//      Organization (#gph) → Restaurant (#restaurant) → WebSite (#website) →
//      WebPage (+ BreadcrumbList) → page-specific entities (schema prop),
//      all linked by @id
//   3. Manages robots directives
//
// This component is consumed exclusively by src/layouts/Layout.astro.
// It must never be imported directly into page files.

import type { PageSeoProps, VenueSchemaConfig, BreadcrumbItem } from '../../types/seo';
import { getSingleton } from '../../content/siteData';
import { menuStubs, pageId } from '../../content/schema';
import { GRIND_AND_PROSPER_NAME, GRIND_AND_PROSPER_URL } from '../../data/gphNetwork';

const venueSettings = await getSingleton('venueSettings', 'settings');
const seoContent = await getSingleton('localSeo', 'localSeo');

interface Props extends PageSeoProps {}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType    = 'website',
  noindex   = false,
  schema,
  breadcrumbs,
  webPage,
} = Astro.props;

// ─── Venue Identity ─────────────────────────────────────────────────────────
// These values are static brand truths. They live here, not in environment
// variables, because they are structural identity facts — not operational
// platform endpoints that rotate.

const VENUE: VenueSchemaConfig = {
  name:               venueSettings.name,
  type:               seoContent.type,
  description:        seoContent.description,
  url:                import.meta.env.PUBLIC_SITE_URL || venueSettings.domain,
  phone:              import.meta.env.PUBLIC_VENUE_PHONE || venueSettings.phoneFallback,
  email:              import.meta.env.PUBLIC_VENUE_EMAIL || venueSettings.emailFallback,
  address: {
    street:   venueSettings.address.street,
    city:     venueSettings.address.city,
    state:    venueSettings.address.state,
    zip:      venueSettings.address.zip,
    country:  venueSettings.address.country,
  },
  geo: {
    latitude:  venueSettings.geo.latitude,
    longitude: venueSettings.geo.longitude,
  },
  hours: Array.isArray(venueSettings.regularHours) ? venueSettings.regularHours : [],
  cuisines: Array.isArray(seoContent.cuisines) ? seoContent.cuisines : [],
  priceRange:           seoContent.priceRange,
  image:                venueSettings.defaultSocialImage,
  logo:                 seoContent.logo,
  acceptsReservations:  seoContent.acceptsReservations,
};

// ─── Canonical URL Resolution ────────────────────────────────────────────────
const siteUrl   = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || venueSettings.domain;
const pagePath  = Astro.url.pathname;
const resolvedCanonical = canonical
  ? `${siteUrl}${canonical}`
  : `${siteUrl}${pagePath}`;

// ─── OG Image Resolution ─────────────────────────────────────────────────────
const resolvedOgImage = ogImage
  ? `${siteUrl}${ogImage}`
  : `${siteUrl}${venueSettings.defaultSocialImage}`;

// ─── JSON-LD: shared entity @ids ───────────────────────────────────────────────
const ORG_ID        = `${siteUrl}/#gph`;
const RESTAURANT_ID = `${siteUrl}/#restaurant`;
const WEBSITE_ID    = `${siteUrl}/#website`;
const WEBPAGE_ID    = pageId(siteUrl, canonical ?? pagePath);
const BREADCRUMB_ID = `${resolvedCanonical}#breadcrumb`;
const MENU_STUBS    = await menuStubs(siteUrl);

// Schema.org rejects "24:00"; emit 23:59 in schema only (stored data and display are unchanged).
const schemaTime = (time: string) => (time === '24:00' ? '23:59' : time);

// OpenTable profile URL for sameAs, derived from the reservations URL with its query string stripped.
const openTableProfile = (() => {
  try {
    const url = new URL(venueSettings.reservationsUrl);
    return url.hostname.endsWith('opentable.com') ? `${url.origin}${url.pathname}` : undefined;
  } catch {
    return undefined;
  }
})();

// ─── JSON-LD: Organization (parent group) ─────────────────────────────────────
const organizationSchema: Record<string, unknown> = {
  '@type': 'Organization',
  '@id':   ORG_ID,
  name:    GRIND_AND_PROSPER_NAME,
  url:     new URL(GRIND_AND_PROSPER_URL).href,
};

// ─── JSON-LD: Restaurant ───────────────────────────────────────────────────────
// The Google rating is shown visually only (StatBar); no aggregateRating is
// marked up, because Google's review-snippet policy disallows self-serving
// ratings aggregated from another site.
const restaurantSchema: Record<string, unknown> = {
  '@type':      VENUE.type,
  '@id':        RESTAURANT_ID,
  name:         VENUE.name,
  description:  VENUE.description,
  url:          VENUE.url,
  telephone:    VENUE.phone,
  email:        VENUE.email,
  priceRange:   VENUE.priceRange,
  image:        `${siteUrl}${VENUE.image}`,
  logo: {
    '@type': 'ImageObject',
    url:     `${siteUrl}${VENUE.logo}`,
  },
  address: {
    '@type':           'PostalAddress',
    streetAddress:     VENUE.address.street,
    addressLocality:   VENUE.address.city,
    addressRegion:     VENUE.address.state,
    postalCode:        VENUE.address.zip,
    addressCountry:    VENUE.address.country,
  },
  geo: {
    '@type':    'GeoCoordinates',
    latitude:   VENUE.geo.latitude,
    longitude:  VENUE.geo.longitude,
  },
  hasMap:               venueSettings.mapsUrl,
  openingHoursSpecification: VENUE.hours.map((h) => ({
    '@type':     'OpeningHoursSpecification',
    dayOfWeek:   `https://schema.org/${h.dayOfWeek}`,
    opens:       schemaTime(h.opens),
    closes:      schemaTime(h.closes),
  })),
  servesCuisine:        VENUE.cuisines,
  hasMenu:              MENU_STUBS.map((menu) => ({ '@id': menu['@id'] })),
  acceptsReservations:  VENUE.acceptsReservations,
  currenciesAccepted:   seoContent.currency,
  paymentAccepted:      seoContent.paymentAccepted,
  amenityFeature: (Array.isArray(seoContent.amenities) ? seoContent.amenities : []).map((name: string) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
  areaServed: [
    { '@type': 'Place', name: venueSettings.address.neighborhood },
    { '@type': 'City', name: venueSettings.address.city },
  ],
  parentOrganization: { '@id': ORG_ID },
  sameAs: [
    venueSettings.social.instagram,
    venueSettings.social.facebook,
    ...(venueSettings.gbpUrl ? [venueSettings.gbpUrl] : []),
    ...(openTableProfile ? [openTableProfile] : []),
  ],
};

// ─── JSON-LD: WebSite ─────────────────────────────────────────────────────────
const websiteSchema: Record<string, unknown> = {
  '@type':    'WebSite',
  '@id':      WEBSITE_ID,
  url:        `${siteUrl}/`,
  name:       VENUE.name,
  inLanguage: 'en-US',
  publisher:  { '@id': RESTAURANT_ID },
};

// ─── JSON-LD: BreadcrumbList ──────────────────────────────────────────────────
const buildBreadcrumbSchema = (items: BreadcrumbItem[]): Record<string, unknown> => ({
  '@type':           'BreadcrumbList',
  '@id':             BREADCRUMB_ID,
  itemListElement:   items.map((item) => ({
    '@type':   'ListItem',
    position:  item.position,
    name:      item.name,
    item:      `${siteUrl}${item.url}`,
  })),
});
const hasBreadcrumbs = Array.isArray(breadcrumbs) && breadcrumbs.length > 0;

// ─── JSON-LD: page-specific entities ─────────────────────────────────────────
const pageEntities = (Array.isArray(schema) ? schema : schema ? [schema] : [])
  .filter(Boolean)
  .map(({ ['@context']: _context, ...entity }) => entity as Record<string, unknown>);
const pageEntityIds = new Set(pageEntities.map((entity) => entity['@id']).filter(Boolean));
const mainEntity = pageEntities.find((entity) => entity['@id'] && entity['@type'] !== 'FAQPage');

// ─── Page Title Formatting ────────────────────────────────────────────────────
// Appends " | {titleSuffix}" only when the title doesn't already carry the brand
// name and only when the result stays within MAX_TITLE_LENGTH characters, so
// every page and blog post gets a correct title with no per-post edits.
const MAX_TITLE_LENGTH = 65;
const BRAND_SUFFIX = seoContent.titleSuffix;
const brandedTitle = `${title} | ${BRAND_SUFFIX}`;
const formattedTitle = !BRAND_SUFFIX || title.includes(BRAND_SUFFIX) || title.includes(VENUE.name) || brandedTitle.length > MAX_TITLE_LENGTH
  ? title
  : brandedTitle;
const resolvedOgImageAlt = ogImageAlt || formattedTitle;

// ─── JSON-LD: WebPage + the single @graph ─────────────────────────────────────
const webPageSchema: Record<string, unknown> = {
  '@type':     'WebPage',
  '@id':       WEBPAGE_ID,
  url:         resolvedCanonical,
  name:        formattedTitle,
  description,
  inLanguage:  'en-US',
  isPartOf:    { '@id': WEBSITE_ID },
  about:       { '@id': RESTAURANT_ID },
  ...(hasBreadcrumbs && { breadcrumb: { '@id': BREADCRUMB_ID } }),
  ...(mainEntity && { mainEntity: { '@id': mainEntity['@id'] } }),
  ...(webPage ?? {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    restaurantSchema,
    websiteSchema,
    webPageSchema,
    ...(hasBreadcrumbs ? [buildBreadcrumbSchema(breadcrumbs!)] : []),
    ...MENU_STUBS.filter((menu) => !pageEntityIds.has(menu['@id'])),
    ...pageEntities,
  ],
};
---

<!-- ─── Primary Meta Tags ─────────────────────────────────────────────── -->
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<meta name="author"      content={seoContent.author} />
<link rel="canonical"    href={resolvedCanonical} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
}

<!-- ─── Open Graph ───────────────────────────────────────────────────── -->
<meta property="og:type"        content={ogType} />
<meta property="og:url"         content={resolvedCanonical} />
<meta property="og:title"       content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={resolvedOgImage} />
<meta property="og:image:alt"   content={resolvedOgImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name"   content={VENUE.name} />
<meta property="og:locale"      content="en_US" />

<!-- ─── Twitter Card ────────────────────────────────────────────────── -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={resolvedOgImage} />
<meta name="twitter:image:alt"   content={resolvedOgImageAlt} />

<!-- ─── Geo & Local Business Meta ──────────────────────────────────── -->
<meta name="geo.region"      content={seoContent.geoRegion} />
<meta name="geo.placename"   content={seoContent.geoPlacename} />
<meta name="geo.position"    content={`${VENUE.geo.latitude};${VENUE.geo.longitude}`} />
<meta name="ICBM"            content={`${VENUE.geo.latitude}, ${VENUE.geo.longitude}`} />

<!-- ─── JSON-LD: single @graph ──────────────────────────────────────── -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 0)} />
