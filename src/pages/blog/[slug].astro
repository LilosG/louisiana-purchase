---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <img src={post.data.image} alt={post.data.imageAlt} class="w-full aspect-video object-cover rounded-lg mb-8" />
    <p class="text-sm text-gray-500 mb-2">
      {new Date(post.data.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
    </p>
    <h1 class="text-4xl font-bold mb-8">{post.data.title}</h1>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Layout>
