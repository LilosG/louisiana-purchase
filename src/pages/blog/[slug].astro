---
// src/pages/blog/[slug].astro
// Louisiana Purchase — Individual Blog Post

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { IMAGES } from '../../assets/images';
import { getSingleton } from '../../content/siteData';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

const venue = await getSingleton('venueSettings', 'settings');
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || venue.domain).replace(/\/$/, '');

const publishedISO = post.data.date.toISOString();
const modifiedISO = (post.data.updatedDate ?? post.data.date).toISOString();

const heroImage = post.data.image ? IMAGES[post.data.image as keyof typeof IMAGES] : undefined;
const ogImagePath = heroImage ? heroImage.src : undefined;

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// ─── JSON-LD: BlogPosting ─────────────────────────────────────────────────
const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  ...(ogImagePath && { image: `${siteUrl}${ogImagePath}` }),
  datePublished: publishedISO,
  dateModified: modifiedISO,
  author: {
    '@type': 'Organization',
    name: venue.name,
  },
  publisher: {
    '@type': 'Organization',
    name: venue.name,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}${venue.defaultSocialImage ?? '/og-image.jpg'}`,
    },
  },
  mainEntityOfPage: `${siteUrl}/blog/${post.id}`,
};

// ─── JSON-LD: FAQPage (only if the post actually has FAQ content) ────────
const faqs = post.data.faqs ?? [];
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;

const schema = faqSchema ? [blogPostingSchema, faqSchema] : [blogPostingSchema];
---

<Layout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  canonical={`/blog/${post.id}`}
  ogType="article"
  ogImage={ogImagePath}
  schema={schema}
  breadcrumbs={[
    { name: 'Home', url: '/', position: 1 },
    { name: 'Blog', url: '/blog', position: 2 },
    { name: post.data.title, url: `/blog/${post.id}`, position: 3 },
  ]}
>

  <!-- ─── Hero ──────────────────────────────────────────────────────────── -->
  <section aria-labelledby="post-headline" class="relative flex flex-col justify-end min-h-[52vh] overflow-hidden bg-obsidian">
    {heroImage && (
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt={post.data.imageAlt || post.data.title}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-obsidian/30 via-obsidian/60 to-obsidian/95"></div>
      </div>
    )}
    <div class="relative z-10 max-w-[860px] mx-auto w-full px-6 pb-14 md:pb-20 pt-24 md:pt-32">
      <p class="font-sans text-[0.5625rem] font-medium tracking-[0.28em] uppercase text-gold mb-4">
        {post.data.category} &middot; {formattedDate}
      </p>
      <h1 id="post-headline" class="font-serif font-light text-parchment tracking-[-0.02em] leading-[1.1]" style="font-size: clamp(2rem, 5vw, 3.5rem);">
        {post.data.title}
      </h1>
    </div>
  </section>

  <!-- ─── Breadcrumb (visible) ──────────────────────────────────────────── -->
  <nav aria-label="Breadcrumb" class="bg-obsidian border-b border-gold/10">
    <div class="max-w-[860px] mx-auto px-6 py-4 flex flex-wrap items-center gap-2 font-sans text-[0.6875rem] text-smoke">
      <a href="/" class="hover:text-gold transition-colors duration-[280ms]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-gold transition-colors duration-[280ms]">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-parchment/70">{post.data.title}</span>
    </div>
  </nav>

  <!-- ─── Body ──────────────────────────────────────────────────────────── -->
  <article class="bg-obsidian py-16 md:py-24">
    <div class="max-w-[720px] mx-auto px-6 blog-content">
      <Content />
    </div>
  </article>

  <!-- ─── FAQ (only if present) ─────────────────────────────────────────── -->
  {faqs.length > 0 && (
    <section aria-labelledby="post-faq-heading" class="bg-velvet py-16 md:py-20">
      <div class="max-w-[720px] mx-auto px-6">
        <h2 id="post-faq-heading" class="font-serif font-light text-parchment leading-tight mb-8" style="font-size: clamp(1.5rem, 3vw, 2rem);">
          Frequently Asked Questions
        </h2>
        <dl class="divide-y divide-gold/10">
          {faqs.map((faq) => (
            <div class="py-5">
              <dt class="font-serif font-light text-parchment text-base mb-2">{faq.q}</dt>
              <dd class="font-sans font-light text-smoke leading-relaxed text-sm">{faq.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- ─── Back to blog ──────────────────────────────────────────────────── -->
  <div class="bg-obsidian py-12 text-center">
    <a href="/blog" class="inline-flex items-center justify-center font-sans text-[0.625rem] font-medium tracking-[0.24em] uppercase rounded-sm px-8 py-4 border border-gold/40 text-gold hover:border-gold hover:bg-gold/5 transition-all duration-[280ms]">
      ← Back to All Posts
    </a>
  </div>

</Layout>

<style>
  .blog-content {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-smoke, rgba(242,235,224,0.7));
  }
  .blog-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-parchment, #f2ebe0);
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }
  .blog-content :global(h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--color-parchment, #f2ebe0);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .blog-content :global(p) {
    margin-bottom: 1.5rem;
  }
  .blog-content :global(ul) {
    margin: 1.5rem 0 2rem;
    padding-left: 0;
    list-style: none;
  }
  .blog-content :global(ol) {
    margin: 1.5rem 0 2rem;
    padding-left: 1.25rem;
  }
  .blog-content :global(li) {
    margin-bottom: 0.875rem;
    padding-left: 1.5rem;
    position: relative;
  }
  .blog-content :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: var(--color-gold, #c9a84c);
  }
  .blog-content :global(strong) {
    color: var(--color-parchment, #f2ebe0);
    font-weight: 500;
  }
  .blog-content :global(a) {
    color: var(--color-gold, #c9a84c);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-content :global(a:hover) {
    color: var(--color-gold-200, #d6bb6f);
  }
</style>
