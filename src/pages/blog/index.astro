---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---
<Layout title="Blog | Louisiana Purchase" description="Creole cooking, cocktails, and North Park culture from Louisiana Purchase.">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-10">Blog</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="block border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <img src={post.data.image} alt={post.data.imageAlt} class="w-full aspect-video object-cover" />
          <div class="p-5">
            <p class="text-sm text-gray-500 mb-1">
              {new Date(post.data.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
            </p>
            <h2 class="text-xl font-semibold mb-2">{post.data.title}</h2>
            <p class="text-gray-600">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
