---
import { getSingleton, resolveContent, buildEnv } from '../../content/siteData';
// src/pages/happy-hour/index.astro
// Louisiana Purchase — Happy Hour Hub Page
// Slug: /happy-hour — permanent, rebrand-proof URL

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import AlternatingRow from '../../components/ui/AlternatingRow.astro';
import StatBar from '../../components/ui/StatBar.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FourColumnGrid from '../../components/ui/FourColumnGrid.astro';
import { IMAGES } from '../../assets/images';
import { getOrderedCollection } from '../../content/siteData';
import { buildFaqSchema } from '../../content/schema';

const pageContent = await getSingleton('happyHourPage', 'page');
const venue = await getSingleton('venueSettings', 'settings');
const FAQ_ITEMS = await getOrderedCollection('happyHourFaqs');

const faqSchema = await buildFaqSchema(pageContent.seo.canonical, FAQ_ITEMS);
const blocks = (Array.isArray(pageContent.blocks) ? pageContent.blocks : []).map((block: any) => resolveContent(block?.props ?? {}, IMAGES, buildEnv(venue, import.meta.env)));
---

<Layout
  title={pageContent.seo.title}
  description={pageContent.seo.description}
  canonical={pageContent.seo.canonical}
  schema={faqSchema ?? undefined}
  breadcrumbs={pageContent.seo.breadcrumbs}
>

  <PageHero {...blocks[0]} />

  <StatBar {...blocks[1]} />

  <AlternatingRow {...blocks[2]} />

  <section aria-labelledby="hh-menu-heading" class="bg-velvet py-20 md:py-24">
    <div class="max-w-[1280px] mx-auto px-6">
      <SectionHeader {...blocks[3]} />
      <FourColumnGrid {...blocks[4]} />
      <div class="text-center mt-10">
        <a href={pageContent.menuLink.href} class="inline-flex items-center justify-center font-sans text-[0.625rem] font-medium tracking-[0.24em] uppercase rounded-sm px-8 py-4 border border-gold/40 text-gold hover:border-gold hover:bg-gold/5 transition-all duration-[280ms]" set:text={`\n${pageContent.menuLink.label}\n`}></a>
      </div>
    </div>
  </section>

  <AlternatingRow {...blocks[5]} />

  <section aria-labelledby="hh-faq-heading" class="bg-velvet py-20 md:py-24">
    <div class="max-w-[1280px] mx-auto px-6">
      <SectionHeader {...blocks[6]} />
      <dl class="divide-y divide-gold/10 max-w-[80ch] mx-auto">
        {FAQ_ITEMS.map((faq) => (
          <div class="py-5 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-12 reveal">
            <dt class="font-serif font-light text-parchment text-base">{faq.q}</dt>
            <dd class="font-sans font-light text-smoke leading-relaxed text-sm">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CTABand {...blocks[7]} />

</Layout>
